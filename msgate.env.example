# Copy to msgate.env next to the install (e.g. /opt/msgate/msgate.env) and customize.
#
# Production: configure Exchange in the Web UI (Settings) after first login.
# MSGATE_EWS_* are optional first-boot seed only (saved to SQLite, then UI wins).
#
# Minimum to reach the UI from another host (laptop → VM):
MSGATE_API_HOST=0.0.0.0
MSGATE_API_PORT=8080

# ---------------------------------------------------------------------------
# How to build MSGATE_EWS_URL (Exchange Web Services)
# ---------------------------------------------------------------------------
# Pattern:
#   https://<your-exchange-host>/EWS/Exchange.asmx
#
# Where <your-exchange-host> is usually one of:
#   - The hostname of your Exchange Client Access / Mailbox server
#   - Your Outlook Web Access (OWA) host (same host, path /EWS/Exchange.asmx)
#   - Autodiscover: in Outlook, File → Account Settings → change account →
#     More Settings → Connection → Exchange Proxy Settings (or ask your
#     Exchange admin for the "EWS endpoint")
#
# Quick checks (from a machine that can reach Exchange):
#   curl -k -I "https://<host>/EWS/Exchange.asmx"
#   # Expect HTTP 401/200/302 — not connection refused / DNS failure
#
# Do not put real passwords or site-specific hosts into this example file.
# Prefer Settings UI after install.
# ---------------------------------------------------------------------------

# Optional first-boot seed (omit if you will use Settings UI):
# MSGATE_EWS_URL=https://mail.example.com/EWS/Exchange.asmx
# MSGATE_EWS_USERNAME=DOMAIN\\svc.msgate
# MSGATE_EWS_PASSWORD=change-me
# MSGATE_EWS_DOMAIN=DOMAIN
# MSGATE_EWS_TLS_MODE=auto
# MSGATE_EWS_TRUST_SELF_SIGNED=false
# MSGATE_EWS_PRIMARY_SMTP=svc.msgate@example.com

# Writable data (systemd install defaults to /var/lib/msgate)
# MSGATE_DATA_DIR=/var/lib/msgate
# MSGATE_LOG_DIR=/var/lib/msgate/logs

# Optional failover Exchange
# MSGATE_EWS_FAILOVER_URL=https://exchange2.example.com/EWS/Exchange.asmx

# Observability
MSGATE_LOG_RETENTION_DAYS=14
# MSGATE_WEBHOOK_URLS=https://hooks.slack.com/services/XXX,https://discord.com/api/webhooks/XXX

# HA metadata (for /api/v1/ha/status)
# MSGATE_NODE_ID=node-1
# MSGATE_HA_ROLE=active
# MSGATE_VRRP_STATE=MASTER
# MSGATE_HA_LEADER=node-1

# Leave unset to auto-generate a key under MSGATE_DATA_DIR (do not set empty).
# MSGATE_SECRET_KEY=
MSGATE_HELP_URL=https://msgate.github.io/msgate/
